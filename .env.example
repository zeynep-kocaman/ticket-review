# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used for the audit-logged writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
# Used to build magic-link redirect URLs. On Vercel, set to your deployment URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated email domains allowed to sign in. Leave blank to allow any
# address that exists in Supabase Auth.
ALLOWED_EMAIL_DOMAINS=enpal.de
